# Formatter A2A service — standalone configuration.
#
# You normally do NOT need this file. The repo-root .env is the single source of
# truth for local development, and formatter_agent/config.py reads it as a
# fallback. Copy this to formatter_agent/.env only when running this service in
# isolation from a checkout with no root .env.
#
# The formatter runs on Vertex AI with the same ADC as the coordinator — there
# is no separate API key. In Cloud Run and Kubernetes these values come from the
# service environment; .env is in .dockerignore and never enters an image.

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
ADK_MODEL=gemini-2.5-flash

# --- A2A advertised RPC location --------------------------------------------
# What the auto-generated agent card advertises as its address. These do NOT
# bind the server (uvicorn's --host/--port do) — they must simply agree with
# wherever the service is actually reachable, or the coordinator dials a dead
# address.
#
#   local:      localhost / 8001 / http
#   Cloud Run:  <svc>-<projectnum>.<region>.run.app / 443 / https
#   Kubernetes: formatter-agent / 8080 / http
A2A_HOST=localhost
A2A_PORT=8001
A2A_PROTOCOL=http
