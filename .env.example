# Financial Research System — configuration template.
#
#   cp .env.example .env    then fill in the four values marked REQUIRED.
#
# This root .env is the single source of truth for local development: run.sh
# exports it into every child process, and each package's config.py also reads
# it as a fallback. Real environment variables always win over this file, which
# is how Cloud Run / Kubernetes inject config without shipping a file.
#
# .env is gitignored. .env.example is committed. Never put a credential here —
# authentication is Application Default Credentials, not API keys:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <your-project-id>

# ============================================================================
# Google Cloud — REQUIRED
# ============================================================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Run Gemini through Vertex AI rather than the AI Studio API. Keep this TRUE:
# VertexAiSearchTool is Vertex-only, so an AI Studio key cannot serve the
# indexed-filings lane, and ADC means there is no key to leak from a public repo.
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# A Vertex AI publisher model id. Do NOT use "gemini-flash-latest" — that is an
# AI Studio alias and it 404s on Vertex.
ADK_MODEL=gemini-2.5-flash

# ============================================================================
# Document AI — REQUIRED for uploads
# ============================================================================
# Console -> Document AI -> Processors -> your OCR processor -> Processor ID
# (the short hex string, not the display name). DOCAI_LOCATION must match the
# region the processor was created in.
DOCAI_PROCESSOR_ID=your-processor-id
DOCAI_LOCATION=us

# Online process_document() caps at 15 pages, so larger PDFs are split. Chunks
# are OCR'd in parallel; raise for speed, lower if you hit quota.
DOCAI_MAX_WORKERS=4

# ============================================================================
# Remote formatter (A2A)
# ============================================================================
# The coordinator's final analysis step runs in a separate process reached over
# A2A. ./run.sh starts it locally on 8001, which is what this default points at.
# The app probes this card at startup and silently falls back to an in-process
# formatter if it is unreachable, so a dead URL degrades instead of breaking.
FORMATTER_A2A_URL=http://localhost:8001/.well-known/agent-card.json

# What the formatter's own agent card advertises as its RPC address. These do
# NOT bind the server (uvicorn's --host/--port do); they must simply agree with
# wherever it is actually reachable.
A2A_HOST=localhost
A2A_PORT=8001
A2A_PROTOCOL=http

# ============================================================================
# Vertex AI Search datastore (optional lane)
# ============================================================================
# Powers the pre-indexed historical-filings specialist. Either a bare datastore
# id or a full resource path. Leave EMPTY to run uploads-only — the app detects
# it, greys the lane out in the UI, and everything else keeps working.
VERTEX_SEARCH_DATASTORE=
VERTEX_SEARCH_LOCATION=global

# What the corpus actually covers, in plain English — e.g.
#   VERTEX_SEARCH_CORPUS=Walmart annual reports, fiscal years 2021 through 2025
# The router classifies without a thinking budget, so it cannot work out on its
# own that a question about some other company is out of scope; naming the scope
# turns that judgement into a string comparison. Leave empty and questions about
# uncovered companies get routed here anyway and come back empty-handed.
VERTEX_SEARCH_CORPUS=

# auto = probe at startup and disable if unreachable (recommended)
# on   = trust it without probing
# off  = disable the lane without probing
ENABLE_DATASTORE=auto

# ============================================================================
# Uploaded-document lane
# ============================================================================
ENABLE_DOCUMENTS=true

# Max characters one read_document() call may return to the model. Uncapped
# reads are the fastest route back to a context blowup.
MAX_DOCUMENT_READ_CHARS=24000
DEFAULT_SEARCH_TOP_K=10

# ============================================================================
# Thinking budgets (latency vs depth)
# ============================================================================
# gemini-2.5 models reason before answering, and that reasoning is billed in
# latency on EVERY hop. Measured on this pipeline: router 3.3s, specialists 13s,
# analyst 7-14s.
#
#    0  thinking disabled     -1  automatic (the model's own default)
#
# The router performs a 3-way classification that reasoning cannot improve, so
# it is off in both modes. The ANALYST is never disabled — its reasoning is the
# compare-and-contrast the product exists for. The Deep research toggle in the
# UI switches the specialists between the two settings below.
THINKING_ROUTER=0
THINKING_SPECIALIST_NORMAL=0
THINKING_SPECIALIST_DEEP=-1
THINKING_ANALYST=-1

# ============================================================================
# Web app
# ============================================================================
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8000

MAX_UPLOAD_MB=25
MAX_DOCS_PER_SESSION=5

# Cache OCR results by file hash in .cache/ocr/ so re-uploading the same PDF
# while rehearsing is instant instead of another 40s of real Document AI spend.
# ./run.sh --fresh clears it.
OCR_CACHE=1
