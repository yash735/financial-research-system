# Coordinator package — standalone configuration.
#
# You normally do NOT need this file. The repo-root .env is the single source of
# truth for local development, and coordinator/config.py reads it as a fallback.
#
# Copy this to coordinator/.env only when running THIS PACKAGE IN ISOLATION —
# e.g. `adk web coordinator` from a checkout with no root .env, or debugging the
# Agent Engine / Cloud Run deploy where the package ships on its own.
#
# In Cloud Run and Kubernetes these come from the service environment instead;
# .env is in .dockerignore and is never baked into an image.

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
ADK_MODEL=gemini-2.5-flash

# Agent card of the remote formatter service.
FORMATTER_A2A_URL=http://localhost:8001/.well-known/agent-card.json

# Optional indexed-filings lane. Bare datastore id or full resource path.
# Leave empty to run without it — the lane disables itself cleanly.
VERTEX_SEARCH_DATASTORE=
VERTEX_SEARCH_LOCATION=global
ENABLE_DATASTORE=auto
